{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:genestack:keystone-admin-rotation:state:1",
  "title": "Keystone admin rotation persistent state v1",
  "$ref": "#/$defs/State",
  "$defs": {
    "Phase": {
      "type": "string",
      "enum": [
        "PREPARE_B",
        "SWITCH_TO_B",
        "VERIFY_B",
        "ROTATE_A",
        "SWITCH_TO_A",
        "VERIFY_A",
        "STABLE_A"
      ]
    },
    "Generation": {
      "type": "string",
      "enum": [
        "admin_old",
        "admin_new",
        "breakglass"
      ]
    },
    "Wave": {
      "type": "string",
      "enum": [
        "to_b",
        "to_a"
      ]
    },
    "Cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kube_system_namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "openstack_namespace_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "kube_system_namespace_uid",
        "openstack_namespace_uid"
      ]
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "enum": [
            "admin",
            "breakglass"
          ]
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "username",
        "user_id",
        "domain_id"
      ]
    },
    "Identities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin": {
          "$ref": "#/$defs/Identity"
        },
        "breakglass": {
          "$ref": "#/$defs/Identity"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "project_domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "required_role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 64
        }
      },
      "required": [
        "admin",
        "breakglass",
        "project_id",
        "project_domain_id",
        "required_role_ids"
      ]
    },
    "Generations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admin_old": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "admin_new": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "breakglass": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "stage_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "breeder_staged": {
          "type": "boolean"
        }
      },
      "required": [
        "admin_old",
        "admin_new",
        "breakglass",
        "stage_attempt",
        "breeder_staged"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "operator_required": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "operator_required",
        "at",
        "operation_id"
      ]
    },
    "Execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "format": "uuid"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "pod_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "pod_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "node_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "job_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "released_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_quiescent": {
          "type": "boolean"
        },
        "prior_owner_settlement": {
          "type": "string",
          "enum": [
            "initial",
            "clean_release",
            "terminated_and_settled",
            "operator_attested"
          ]
        },
        "settlement_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettlementEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "execution_id",
        "epoch",
        "pod_name",
        "pod_uid",
        "node_name",
        "job_uid",
        "acquired_at",
        "released_at",
        "release_quiescent",
        "prior_owner_settlement",
        "settlement_evidence"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "kind": {
          "type": "string",
          "enum": [
            "Secret",
            "Deployment",
            "DaemonSet",
            "Pod"
          ]
        },
        "namespace": {
          "const": "openstack"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "api_version",
        "kind",
        "namespace",
        "name"
      ]
    },
    "ObjectBaseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/$defs/ObjectRef"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "last_resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "protected_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "object",
        "uid",
        "last_resource_version",
        "protected_digest"
      ]
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "initial_generation": {
          "$ref": "#/$defs/Generation"
        },
        "observed_generation": {
          "$ref": "#/$defs/Generation"
        },
        "observed_fingerprint": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "last_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "object_key",
        "initial_generation",
        "observed_generation",
        "observed_fingerprint",
        "last_operation_id",
        "last_observed_at"
      ]
    },
    "Lockout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "initial_value": {
          "type": "string",
          "enum": [
            "absent",
            "false"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "normal",
            "suppress_intent",
            "suppressed",
            "restore_intent",
            "restored"
          ]
        },
        "suppression_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "restoration_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ever_observed_suppressed": {
          "type": "boolean"
        },
        "last_observed_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore_required": {
          "type": "boolean"
        }
      },
      "required": [
        "user_id",
        "initial_value",
        "state",
        "suppression_operation_id",
        "restoration_operation_id",
        "ever_observed_suppressed",
        "last_observed_value",
        "last_observed_at",
        "restore_required"
      ]
    },
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "authority",
            "identity",
            "topology",
            "runtime",
            "credential_effect",
            "functional",
            "lockout",
            "completion"
          ]
        },
        "wave": {
          "anyOf": [
            {
              "$ref": "#/$defs/Wave"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_id": {
          "type": "string",
          "format": "uuid"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "covers_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "maxItems": 64
        },
        "object_uids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 256
        },
        "evidence_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        }
      },
      "required": [
        "check_id",
        "purpose",
        "wave",
        "status",
        "observed_at",
        "execution_id",
        "epoch",
        "covers_actions",
        "object_uids",
        "evidence_digest",
        "code"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "wave": {
          "$ref": "#/$defs/Wave"
        },
        "token": {
          "type": "string",
          "format": "uuid"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 256
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "maxItems": 256
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "applied",
            "verified"
          ]
        },
        "target_uid_before": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "target_uid_after": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_after": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "desired_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "last_operation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "wave",
        "token",
        "causes",
        "location_ids",
        "status",
        "target_uid_before",
        "target_uid_after",
        "generation_after",
        "desired_count",
        "last_operation_id",
        "last_verified_at"
      ]
    },
    "CredentialChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "before": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "after": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "location_id",
        "before",
        "after"
      ]
    },
    "PatchSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "patch_secret"
        },
        "object": {
          "$ref": "#/$defs/ObjectRef"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "protected_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CredentialChange"
          },
          "maxItems": 64
        },
        "wave": {
          "anyOf": [
            {
              "$ref": "#/$defs/Wave"
            },
            {
              "type": "null"
            }
          ]
        },
        "breeder_stage": {
          "type": "boolean"
        },
        "stage_attempt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
          },
          "maxItems": 64
        }
      },
      "required": [
        "kind",
        "object",
        "uid",
        "resource_version",
        "protected_digest",
        "changes",
        "wave",
        "breeder_stage",
        "stage_attempt",
        "action_ids"
      ]
    },
    "PatchKeystonePassword": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "patch_keystone_password"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "before": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "after": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "protected_user_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kind",
        "user_id",
        "before",
        "after",
        "protected_user_digest"
      ]
    },
    "PatchLockout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "patch_lockout"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "before": {
          "type": "boolean"
        },
        "after": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "capability",
            "suppress",
            "restore"
          ]
        },
        "protected_user_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kind",
        "user_id",
        "before",
        "after",
        "purpose",
        "protected_user_digest"
      ]
    },
    "PatchPasswordSafe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "patch_passwordsafe"
        },
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "credential_id": {
          "type": "integer",
          "minimum": 1
        },
        "before_version": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "after": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "capability",
            "rotate"
          ]
        }
      },
      "required": [
        "kind",
        "project_id",
        "credential_id",
        "before_version",
        "before",
        "after",
        "purpose"
      ]
    },
    "Rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rollout_restart"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "wave": {
          "$ref": "#/$defs/Wave"
        },
        "object": {
          "$ref": "#/$defs/ObjectRef"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "protected_digest": {
          "type": "string",
          "pattern": "^hmac-sha256:v1:[a-z0-9_.-]{1,64}:[A-Za-z0-9_-]{43}$"
        },
        "token": {
          "type": "string",
          "format": "uuid"
        },
        "desired_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "action_id",
        "wave",
        "object",
        "uid",
        "resource_version",
        "protected_digest",
        "token",
        "desired_count"
      ]
    },
    "DeletePod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "delete_pod"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "wave": {
          "$ref": "#/$defs/Wave"
        },
        "object": {
          "$ref": "#/$defs/ObjectRef"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resource_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "token": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "action_id",
        "wave",
        "object",
        "uid",
        "resource_version",
        "token"
      ]
    },
    "CreatePod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "create_pod"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
        },
        "wave": {
          "$ref": "#/$defs/Wave"
        },
        "object": {
          "$ref": "#/$defs/ObjectRef"
